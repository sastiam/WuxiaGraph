  "cards": [
    {
      "dot": "emerald",
      "title": "Mass Ingestion Architecture",
      "items": [
        "Layout-aware PDF parsing preserves narrative text while eliminating pagination artifacts across 500+ pages",
        "Dual Regex + LLM Light chapter discovery parses Wuxia/Xianxia table of contents and chapter headings",
        "Sliding window strategy prevents narrative fragmentation across chapter boundaries"
      ]
    },
    {
      "dot": "rose",
      "title": "WIP Governance & Cost Circuit Breaker",
      "items": [
        "Every batch worker verifies remaining token budget and weekly 4.0h WIP limits",
        "Automatic checkpointing on HTTP 423 LOCKED_BY_WIP allows non-destructive pause and resume",
        "Protects against API rate limits and unexpected token billing spikes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lore Consistency & Temporal Fact Ledger",
      "items": [
        "Co-reference engine handles Wuxia alias evolution (e.g. Young Master -> Elder -> Immortal)",
